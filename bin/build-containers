#!/usr/bin/env bash
set -euo pipefail

# Usage:
#   build-containers [--no-cache] [base|claude|codex|pi|herdr|all]
#
# Defaults to `all` when called with no argument. For `all`, the base image is
# ensured first, then the flavor images build in parallel by default.
# Stale existing base images are refreshed only after an interactive [y/N]
# prompt. Output from parallel builds is prefixed with [flavor] so lines stay
# attributable.
#
# Env vars:
#   CLAUDE_NO_CACHE=1       pass --no-cache to podman build
#   AISB_BUILD_SEQUENTIAL=1 build claude/codex/pi/herdr sequentially for `all`
#   BASE_IMAGE              override base image tag (default: localhost/aisb-base:latest)
#   AISB_WORKSPACE          workspace root to inspect for .aisb.env (default: cwd git root)
#
# Each flavor's image tag matches what the run-* wrappers expect:
#   base    -> localhost/aisb-base:latest, repo-provided AISB_BASE_IMAGE,
#              or localhost/aisb-<repo-name>-<repo-hash>:latest for a project Containerfile
#   claude  -> aisb-claude:latest, or localhost/aisb-claude-<repo-hash>:latest
#   codex   -> aisb-codex:latest, or localhost/aisb-codex-<repo-hash>:latest
#   pi      -> aisb-pi:latest, or localhost/aisb-pi-<repo-hash>:latest
#   herdr   -> aisb-herdr:latest, or localhost/aisb-herdr-<repo-hash>:latest

SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" == /* ]] || SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

# shellcheck source=bin/_repo-config.sh
source "$SCRIPT_DIR/_repo-config.sh"

usage() {
  cat <<'EOF'
Usage:
  build-containers [--no-cache] [base|claude|codex|pi|herdr|all]

Options:
  --no-cache   Pass --no-cache to podman build
  -h, --help   Show this help
EOF
}

NO_CACHE=0
FLAVOR="all"
FLAVOR_SET=0
while (($#)); do
  case "$1" in
    --no-cache)
      NO_CACHE=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    --)
      shift
      if (($# == 0)); then
        break
      fi
      if ((FLAVOR_SET)); then
        echo "error: unexpected argument '$1'" >&2
        usage >&2
        exit 2
      fi
      FLAVOR="$1"
      FLAVOR_SET=1
      shift
      if (($#)); then
        echo "error: unexpected argument '$1'" >&2
        usage >&2
        exit 2
      fi
      break
      ;;
    -*)
      echo "error: unknown option '$1'" >&2
      usage >&2
      exit 2
      ;;
    *)
      if ((FLAVOR_SET)); then
        echo "error: unexpected argument '$1'" >&2
        usage >&2
        exit 2
      fi
      FLAVOR="$1"
      FLAVOR_SET=1
      ;;
  esac
  shift
done

case "$FLAVOR" in
  base|claude|codex|pi|herdr|all)
    ;;
  *)
    echo "error: unknown flavor '$FLAVOR' (expected: base|claude|codex|pi|herdr|all)" >&2
    usage >&2
    exit 2
    ;;
esac

if [[ -n "${AISB_WORKSPACE:-}" ]]; then
  WORKSPACE_ROOT="$AISB_WORKSPACE"
elif git rev-parse --show-toplevel >/dev/null 2>&1; then
  WORKSPACE_ROOT="$(git rev-parse --show-toplevel)"
else
  WORKSPACE_ROOT="$PWD"
fi
WORKSPACE_ROOT="$(realpath "$WORKSPACE_ROOT")"
WORKSPACE_HASH="$(aisb_sha1_10 "$WORKSPACE_ROOT")"
aisb_load_repo_env "$WORKSPACE_ROOT"

# A project Containerfile already determines the base image: AISB_REPO_BASE_IMAGE
# is the tag derived from it. Writing that same tag into .aisb.env as
# AISB_BASE_IMAGE therefore cannot change which image is used -- but it does
# change the mode. An explicit AISB_BASE_IMAGE means "the user owns the runtime",
# which discards AISB_NPM_PACKAGES/AISB_PYTHON_TOOLS and warns on every run that
# the Containerfile is unused.
#
# This used to be offered as "persist this choice", which invited people to opt
# into a different mode believing they were saving the current one. There is no
# choice to persist here, so just report what is being used.
announce_repo_base_image() {
  [[ -z "${BASE_IMAGE:-}" ]] || return 0
  [[ -n "${AISB_REPO_CONTAINERFILE:-}" ]] || return 0
  [[ "${AISB_REPO_ENV_HAS_BASE_IMAGE:-0}" != "1" ]] || return 0

  echo "Detected project Containerfile: $AISB_REPO_CONTAINERFILE"
  echo "Using repo base image: $AISB_REPO_BASE_IMAGE"
}

announce_repo_base_image

BASE_IMAGE_EXPLICIT=0
if [[ -n "${BASE_IMAGE:-}" ]]; then
  BASE_IMAGE_EXPLICIT=1
  BASE_IMAGE_TAG="$BASE_IMAGE"
elif [[ -n "${AISB_REPO_BASE_IMAGE:-}" ]]; then
  BASE_IMAGE_TAG="$AISB_REPO_BASE_IMAGE"
else
  BASE_IMAGE_TAG="localhost/aisb-base:latest"
fi

REPO_SCOPED_TOOL_IMAGES=0
if [[ -n "${AISB_REPO_BASE_IMAGE:-}" ]]; then
  REPO_SCOPED_TOOL_IMAGES=1
fi

COMMON_FLAGS=()
if [[ "$NO_CACHE" == "1" || "${CLAUDE_NO_CACHE:-0}" == "1" ]]; then
  COMMON_FLAGS+=(--no-cache)
fi

GENERATED_CONTAINERFILE=""
cleanup_generated_containerfile() {
  if [[ -n "$GENERATED_CONTAINERFILE" && -f "$GENERATED_CONTAINERFILE" ]]; then
    rm -f "$GENERATED_CONTAINERFILE"
  fi
  # Must return 0: this runs as the EXIT trap, and a non-zero status here would
  # become the script's exit code even after a successful build.
  return 0
}
trap cleanup_generated_containerfile EXIT

repo_base_is_local_containerfile() {
  [[ "$BASE_IMAGE_EXPLICIT" != "1" ]] && aisb_repo_base_is_local_containerfile
}

repo_base_is_generated() {
  [[ "$BASE_IMAGE_EXPLICIT" != "1" ]] && aisb_repo_base_is_generated
}

repo_base_is_external_image() {
  [[ -n "${AISB_REPO_BASE_IMAGE:-}" && "$BASE_IMAGE_EXPLICIT" != "1" ]] \
    && ! repo_base_is_local_containerfile && ! repo_base_is_generated
}

# Build the default localhost/aisb-base:latest if missing or stale. The generated
# repo base is layered on top of it (FROM localhost/aisb-base:latest), so it must
# exist and match the current recipe before the generated layer is built.
ensure_default_base() {
  local tag="localhost/aisb-base:latest"
  local expected actual
  expected="$(aisb_default_base_recipe_fingerprint "$REPO_ROOT")"
  resolve_python_tool_versions

  if podman image exists "$tag"; then
    actual="$(image_label "$tag" "io.aisb.recipe_fingerprint")"
    if [[ -n "$actual" && "$actual" == "$expected" ]] \
      && image_has_current_python_tools "$tag"; then
      return 0
    fi
    echo "Default base image '$tag' is stale; rebuilding it first."
  else
    echo "Default base image '$tag' not found; building it first."
  fi

  local -a flags=("${COMMON_FLAGS[@]}")
  append_python_tool_build_args flags
  flags+=(
    --label "io.aisb.managed=true"
    --label "io.aisb.flavor=base"
    --label "io.aisb.recipe_fingerprint=$expected"
  )
  echo "Building $tag from $REPO_ROOT/Containerfile.base"
  podman build \
    "${flags[@]}" \
    -t "$tag" \
    -f "$REPO_ROOT/Containerfile.base" \
    "$REPO_ROOT"
}

# Write a Containerfile that layers the repo's declared packages on the default
# base. Each token is single-quoted; aisb_is_valid_package_token has already
# rejected any token that could break out of the quotes or the RUN line. Built
# with REPO_ROOT as context so the COPY can reuse the shipped installer script.
write_generated_base_containerfile() {
  local tmp pkg
  tmp="$(mktemp "${TMPDIR:-/tmp}/aisb-Containerfile.XXXXXX")"
  GENERATED_CONTAINERFILE="$tmp"

  {
    printf '# Generated by aisb from %s. Do not edit; edit .aisb.env instead.\n' \
      "$AISB_REPO_ENV_FILE"
    printf 'FROM localhost/aisb-base:latest\n'

    if ((${#AISB_REPO_PYTHON_TOOLS[@]})); then
      printf '\nCOPY --chmod=0755 container/install-agent-python-tools.sh /usr/local/bin/aisb-install-agent-python-tools\n'
      printf 'RUN /usr/local/bin/aisb-install-agent-python-tools'
      for pkg in "${AISB_REPO_PYTHON_TOOLS[@]}"; do
        printf " '%s'" "$pkg"
      done
      printf ' \\\n && rm /usr/local/bin/aisb-install-agent-python-tools\n'
    fi

    if ((${#AISB_REPO_NPM_PACKAGES[@]})); then
      printf '\nRUN npm install -g'
      for pkg in "${AISB_REPO_NPM_PACKAGES[@]}"; do
        printf " '%s'" "$pkg"
      done
      # $NPM_CONFIG_CACHE is expanded by the container shell at image build time.
      # shellcheck disable=SC2016
      printf ' \\\n && rm -rf "$NPM_CONFIG_CACHE"\n'
    fi
  } > "$tmp"

  printf '%s' "$tmp"
}

# Herdr is a prebuilt binary released through the herdr.dev manifest — the
# same source `herdr update` and the upstream installer use. Prints
# "version<TAB>url" for the build host's architecture (podman builds native).
resolve_herdr_release() {
  local manifest arch target version url
  case "$(uname -m)" in
    x86_64|amd64)   arch="x86_64" ;;
    aarch64|arm64)  arch="aarch64" ;;
    *)
      echo "error: unsupported architecture for herdr: $(uname -m)" >&2
      return 1
      ;;
  esac
  target="linux-${arch}"

  if ! manifest="$(curl -fsSL --retry 3 --connect-timeout 10 --max-time 20 https://herdr.dev/latest.json)"; then
    echo "error: could not fetch https://herdr.dev/latest.json (is curl installed and online?)" >&2
    return 1
  fi

  version="$(printf '%s\n' "$manifest" | awk -F '"' '/^[[:space:]]*"version"[[:space:]]*:/ { print $4; exit }')"
  url="$(printf '%s\n' "$manifest" | awk -v target="\"${target}\"" '
    /^[[:space:]]*"assets"[[:space:]]*:/ { in_assets = 1; next }
    in_assets && /^[[:space:]]*}/ { exit }
    in_assets && index($0, target) {
      sub(/^.*:[[:space:]]*"/, "")
      sub(/".*$/, "")
      print
      exit
    }
  ')"

  if [[ -z "$version" || -z "$url" ]]; then
    echo "error: herdr release manifest does not include a binary for ${target}" >&2
    return 1
  fi
  printf '%s\t%s' "$version" "$url"
}

resolve_npm_version() {
  local pkg="$1"
  local version
  if ! version="$(NPM_CONFIG_FUND=false NPM_CONFIG_UPDATE_NOTIFIER=false npm view "$pkg" version 2>/dev/null)" || [[ -z "$version" ]]; then
    echo "error: could not resolve npm version for $pkg (is npm installed and online?)" >&2
    return 1
  fi
  printf '%s' "$version"
}

resolve_pypi_version() {
  local pkg="$1"
  local version
  if ! version="$({
    curl -fsSL --retry 3 --connect-timeout 10 --max-time 30 \
      "https://pypi.org/pypi/${pkg}/json"
  } | node -e '
    let body = "";
    process.stdin.setEncoding("utf8");
    process.stdin.on("data", chunk => { body += chunk; });
    process.stdin.on("end", () => {
      try {
        const version = JSON.parse(body)?.info?.version;
        if (typeof version !== "string" || version.length === 0) process.exit(1);
        process.stdout.write(version);
      } catch {
        process.exit(1);
      }
    });
  ')" || [[ -z "$version" ]]; then
    echo "error: could not resolve PyPI version for $pkg (are curl and node installed and online?)" >&2
    return 1
  fi
  if [[ ! "$version" =~ ^[0-9A-Za-z][0-9A-Za-z._+-]*$ ]]; then
    echo "error: PyPI returned an unsafe version for $pkg: $version" >&2
    return 1
  fi
  printf '%s' "$version"
}

PYTHON_TOOL_VERSIONS_RESOLVED=0
RUFF_VERSION=""
TY_VERSION=""
PREK_VERSION=""

resolve_python_tool_versions() {
  if [[ "$PYTHON_TOOL_VERSIONS_RESOLVED" == "1" ]]; then
    return 0
  fi

  RUFF_VERSION="$(resolve_pypi_version ruff)"
  TY_VERSION="$(resolve_pypi_version ty)"
  PREK_VERSION="$(resolve_pypi_version prek)"
  PYTHON_TOOL_VERSIONS_RESOLVED=1
  echo "Latest Python tool versions: ruff=$RUFF_VERSION ty=$TY_VERSION prek=$PREK_VERSION"
}

append_python_tool_build_args() {
  local -n build_flags="$1"
  resolve_python_tool_versions
  build_flags+=(
    --build-arg "RUFF_VERSION=$RUFF_VERSION"
    --build-arg "TY_VERSION=$TY_VERSION"
    --build-arg "PREK_VERSION=$PREK_VERSION"
  )
}

image_label() {
  local image="$1"
  local label="$2"
  podman image inspect --format "{{if .Config.Labels}}{{index .Config.Labels \"$label\"}}{{end}}" "$image" 2>/dev/null || true
}

image_has_current_python_tools() {
  local image="$1"
  resolve_python_tool_versions
  [[ "$(image_label "$image" "io.aisb.python-tool.ruff.version")" == "$RUFF_VERSION" ]] \
    && [[ "$(image_label "$image" "io.aisb.python-tool.ty.version")" == "$TY_VERSION" ]] \
    && [[ "$(image_label "$image" "io.aisb.python-tool.prek.version")" == "$PREK_VERSION" ]]
}

managed_base_image_is_stale() {
  local actual_recipe expected_recipe

  if repo_base_is_external_image; then
    return 1
  fi

  if ! podman image exists "$BASE_IMAGE_TAG"; then
    return 0
  fi

  actual_recipe="$(image_label "$BASE_IMAGE_TAG" "io.aisb.recipe_fingerprint")"
  expected_recipe="$(aisb_expected_recipe_fingerprint "$REPO_ROOT" "$WORKSPACE_ROOT" base)"

  if [[ -z "$actual_recipe" || "$actual_recipe" != "$expected_recipe" ]]; then
    return 0
  fi

  # A project-authored Containerfile owns its own package policy. Managed
  # default/generated bases, however, should refresh when bundled tools move.
  if repo_base_is_local_containerfile; then
    return 1
  fi

  ! image_has_current_python_tools "$BASE_IMAGE_TAG"
}

BASE_STALE_REFRESH_ASKED=0

maybe_prompt_refresh_stale_base_image() {
  local consumer="${1:-tool}"
  local build_cmd reply

  managed_base_image_is_stale || return 0
  if [[ "${BASE_STALE_REFRESH_ASKED:-0}" == "1" ]]; then
    return 0
  fi
  BASE_STALE_REFRESH_ASKED=1

  build_cmd="$(aisb_build_command_hint "$SCRIPT_DIR" "$WORKSPACE_ROOT" base)"
  if [[ ! -t 0 || ! -t 1 ]]; then
    echo "warn: base image '$BASE_IMAGE_TAG' may be stale; reusing it for $consumer build" >&2
    echo "warn: refresh it explicitly with: $build_cmd" >&2
    return 0
  fi

  echo "Base image '$BASE_IMAGE_TAG' may be stale." >&2
  printf "Refresh it now with \`%s\` before the %s build? [y/N] " "$build_cmd" "$consumer" >&2
  read -r reply || reply=""
  case "$reply" in
    y|Y|yes|Yes|YES)
      build_one base
      ;;
    *)
      echo "Reusing existing base image: $BASE_IMAGE_TAG" >&2
      ;;
  esac
}

ensure_base_image_exists() {
  local consumer="${1:-tool}"

  if podman image exists "$BASE_IMAGE_TAG"; then
    maybe_prompt_refresh_stale_base_image "$consumer"
    return 0
  fi

  if repo_base_is_external_image; then
    echo "error: repo base image '$BASE_IMAGE_TAG' from $WORKSPACE_ROOT/.aisb.env was not found" >&2
    echo "Build or pull that image first, then retry." >&2
    return 1
  fi

  echo "Base image '$BASE_IMAGE_TAG' not found; building it first."
  build_one base
}

build_one() {
  local flavor="$1"
  local containerfile="$REPO_ROOT/Containerfile.$flavor"
  local build_context="$REPO_ROOT"

  if [[ "$flavor" == "base" ]]; then
    if repo_base_is_local_containerfile; then
      containerfile="$AISB_REPO_CONTAINERFILE"
      build_context="$WORKSPACE_ROOT"
    elif repo_base_is_generated; then
      containerfile="$(write_generated_base_containerfile)"
      build_context="$REPO_ROOT"
    fi
  fi

  if [[ ! -f "$containerfile" ]]; then
    echo "error: $containerfile not found" >&2
    return 1
  fi

  local -a flags=("${COMMON_FLAGS[@]}")
  local tag recipe_fingerprint base_image_id build_flavor

  build_flavor="$flavor"

  if [[ "$flavor" != "base" || "$containerfile" == "$REPO_ROOT/Containerfile.base" ]]; then
    append_python_tool_build_args flags
  fi

  case "$flavor" in
    base)
      tag="$BASE_IMAGE_TAG"
      build_flavor="base"
      if [[ -n "${AISB_REPO_BASE_IMAGE:-}" && "$BASE_IMAGE_EXPLICIT" != "1" ]] \
        && ! repo_base_is_local_containerfile && ! repo_base_is_generated; then
        if ! podman image exists "$BASE_IMAGE_TAG"; then
          echo "error: repo base image '$BASE_IMAGE_TAG' from $WORKSPACE_ROOT/.aisb.env was not found" >&2
          echo "Build or pull that image first, then retry." >&2
          return 1
        fi
        echo "Using repo-provided base image: $BASE_IMAGE_TAG"
        return 0
      fi
      if repo_base_is_local_containerfile; then
        echo "Using project Containerfile as repo base: $AISB_REPO_CONTAINERFILE"
      elif repo_base_is_generated; then
        ensure_default_base
        base_image_id="$(podman image inspect --format '{{.Id}}' localhost/aisb-base:latest)"
        echo "Building generated repo base with packages declared in $AISB_REPO_ENV_FILE"
      fi
      ;;
    claude)
      if [[ "$REPO_SCOPED_TOOL_IMAGES" == "1" ]]; then
        tag="$(aisb_derived_tool_image claude "$WORKSPACE_HASH")"
      else
        tag="aisb-claude:latest"
      fi
      flags+=(--build-arg "BASE_IMAGE=$BASE_IMAGE_TAG")
      ensure_base_image_exists "$flavor"
      base_image_id="$(podman image inspect --format '{{.Id}}' "$BASE_IMAGE_TAG")"
      local claude_version
      claude_version="$(resolve_npm_version @anthropic-ai/claude-code)"
      echo "Latest Claude Code version: $claude_version"
      flags+=(--build-arg "CLAUDE_VERSION=$claude_version")
      ;;
    codex)
      if [[ "$REPO_SCOPED_TOOL_IMAGES" == "1" ]]; then
        tag="$(aisb_derived_tool_image codex "$WORKSPACE_HASH")"
      else
        tag="aisb-codex:latest"
      fi
      flags+=(--build-arg "BASE_IMAGE=$BASE_IMAGE_TAG")
      ensure_base_image_exists "$flavor"
      base_image_id="$(podman image inspect --format '{{.Id}}' "$BASE_IMAGE_TAG")"
      local codex_version
      codex_version="$(resolve_npm_version @openai/codex)"
      echo "Latest Codex version: $codex_version"
      flags+=(--build-arg "CODEX_VERSION=$codex_version")
      ;;
    pi)
      if [[ "$REPO_SCOPED_TOOL_IMAGES" == "1" ]]; then
        tag="$(aisb_derived_tool_image pi "$WORKSPACE_HASH")"
      else
        tag="aisb-pi:latest"
      fi
      flags+=(--build-arg "BASE_IMAGE=$BASE_IMAGE_TAG")
      ensure_base_image_exists "$flavor"
      base_image_id="$(podman image inspect --format '{{.Id}}' "$BASE_IMAGE_TAG")"
      local pi_version
      pi_version="$(resolve_npm_version @earendil-works/pi-coding-agent)"
      echo "Latest pi-coding-agent version: $pi_version"
      flags+=(--build-arg "PI_VERSION=$pi_version")
      ;;
    herdr)
      if [[ "$REPO_SCOPED_TOOL_IMAGES" == "1" ]]; then
        tag="$(aisb_derived_tool_image herdr "$WORKSPACE_HASH")"
      else
        tag="aisb-herdr:latest"
      fi
      flags+=(--build-arg "BASE_IMAGE=$BASE_IMAGE_TAG")
      ensure_base_image_exists "$flavor"
      base_image_id="$(podman image inspect --format '{{.Id}}' "$BASE_IMAGE_TAG")"
      local herdr_release herdr_version herdr_url
      herdr_release="$(resolve_herdr_release)"
      IFS=$'\t' read -r herdr_version herdr_url <<< "$herdr_release"
      echo "Latest herdr version: $herdr_version"
      flags+=(
        --build-arg "HERDR_VERSION=$herdr_version"
        --build-arg "HERDR_URL=$herdr_url"
      )
      # Herdr multiplexes agents, so its image bundles the whole herd.
      local herd_claude herd_codex herd_pi
      herd_claude="$(resolve_npm_version @anthropic-ai/claude-code)"
      herd_codex="$(resolve_npm_version @openai/codex)"
      herd_pi="$(resolve_npm_version @earendil-works/pi-coding-agent)"
      echo "Bundled herd versions: claude=$herd_claude codex=$herd_codex pi=$herd_pi"
      flags+=(
        --build-arg "CLAUDE_VERSION=$herd_claude"
        --build-arg "CODEX_VERSION=$herd_codex"
        --build-arg "PI_VERSION=$herd_pi"
      )
      ;;
    *)
      echo "error: unknown flavor '$flavor' (expected: base|claude|codex|pi|herdr|all)" >&2
      return 2
      ;;
  esac

  recipe_fingerprint="$(aisb_expected_recipe_fingerprint "$REPO_ROOT" "$WORKSPACE_ROOT" "$build_flavor")"
  flags+=(
    --label "io.aisb.managed=true"
    --label "io.aisb.flavor=$build_flavor"
    --label "io.aisb.recipe_fingerprint=$recipe_fingerprint"
  )
  if [[ -n "${base_image_id:-}" ]]; then
    flags+=(--label "io.aisb.base_image_id=$base_image_id")
  fi

  echo "Building $tag from $containerfile"
  podman build \
    "${flags[@]}" \
    -t "$tag" \
    -f "$containerfile" \
    "$build_context"
}

build_all_sequential() {
  local f
  for f in claude codex pi herdr; do
    build_one "$f"
  done
}

build_all_parallel() {
  local -a pids=()
  local -a labels=()
  local f fail i

  for f in claude codex pi herdr; do
    (build_one "$f" 2>&1 | sed -u "s/^/[$f] /") &
    pids+=($!)
    labels+=("$f")
  done

  fail=0
  for i in "${!pids[@]}"; do
    if ! wait "${pids[$i]}"; then
      echo "build failed: ${labels[$i]}" >&2
      fail=$((fail + 1))
    fi
  done

  if (( fail > 0 )); then
    echo "$fail flavor build(s) failed" >&2
    return 1
  fi
}

case "$FLAVOR" in
  all)
    # Resolve once in the parent so parallel flavor builds share one version
    # set and do not each download the same PyPI metadata.
    resolve_python_tool_versions
    ensure_base_image_exists all
    if [[ "${AISB_BUILD_SEQUENTIAL:-0}" == "1" ]]; then
      build_all_sequential
    else
      build_all_parallel
    fi
    ;;
  *)
    build_one "$FLAVOR"
    ;;
esac
