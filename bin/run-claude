#!/usr/bin/env bash
set -euo pipefail
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" == /* ]] || SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"

TOOL="claude"
USER_NAME="aisb-$TOOL"
USER_HOME="/home/$USER_NAME"
AISB_MOUNT_USER_HOME_TMPFS=0

# shellcheck source=bin/_run-common.sh
source "$SCRIPT_DIR/_run-common.sh"
common_init

common_require_mount_path "$HOME/.claude.json" "Claude host config path"
common_require_mount_path "${USER_HOME}/.claude.json" "Claude container config path"
common_require_mount_path "$HOME/.claude" "Claude host state path"
common_require_mount_path "${USER_HOME}/.claude" "Claude container state path"

common_check_image

# Ensure host-side files exist. Claude's config directory is mounted rw so its
# atomic credential/settings writes persist normally.
mkdir -p "$HOME/.claude"
common_ensure_json_object_file "$HOME/.claude.json" "Claude host config"
common_ensure_json_object_file "$HOME/.claude/.credentials.json" "Claude credentials"
common_ensure_json_object_file "$HOME/.claude/settings.json" "Claude settings"

CLAUDE_HOME_DIR="${STATE_BASE}/claude/home-claude"
common_maybe_reset_tool_home "$CLAUDE_HOME_DIR"
mkdir -p "$CLAUDE_HOME_DIR"
# Pre-create .config so podman doesn't auto-create it as namespace-root when
# bind-mounting ~/.config/gh, leaving the parent unwritable to the calling user.
mkdir -p "$CLAUDE_HOME_DIR/.config"

common_require_mount_path "${CLAUDE_HOME_DIR}" "Claude shared home source path"
common_require_mount_path "${CLAUDE_HOME_DIR}/.claude" "Claude shared state source path"
common_require_mount_path "${CLAUDE_HOME_DIR}/.claude.json" "Claude shared config source path"
common_require_mount_path "${CLAUDE_HOME_DIR}/.claude/settings.json" "Claude shared settings source path"
common_require_mount_path "${CLAUDE_HOME_DIR}/.claude/.credentials.json" "Claude shared credentials source path"

claude_project_mcp_json_is_usable() {
  [[ -f "$ROOT/.mcp.json" && -r "$ROOT/.mcp.json" ]]
}

claude_check_project_mcp_json() {
  local mcp_path="$ROOT/.mcp.json"

  if [[ ! -e "$mcp_path" ]]; then
    return 0
  fi

  if claude_project_mcp_json_is_usable; then
    return 0
  fi

  echo "Error: project .mcp.json exists but is not readable: $mcp_path" >&2
  ls -ld "$ROOT" "$mcp_path" >&2 || true
  if command -v stat >/dev/null 2>&1; then
    stat -c '[aisb:claude] %n mode=%a owner=%U group=%G context=%C' "$ROOT" "$mcp_path" >&2 || true
  fi
  echo >&2
  echo "Fix file permissions if this project intentionally uses .mcp.json:" >&2
  echo "  chmod u+r '$mcp_path'" >&2
  echo >&2
  echo "On SELinux hosts, fix the label or rerun once with workspace relabeling enabled:" >&2
  echo "  AISB_RELABEL_WORKSPACE=1 claude" >&2
  exit 1
}

claude_preflight_workspace_mount() {
  local output status

  set +e
  output="$(
    podman run "${COMMON_PODMAN_ARGS[@]}" \
      --entrypoint /bin/sh \
      "$IMAGE" \
      -c '
        set -eu
        pwd >/dev/null
        ls -ld . >/dev/null
        if [ -e .mcp.json ]; then
          test -r .mcp.json
        fi
      ' 2>&1
  )"
  status=$?
  set -e

  if (( status == 0 )); then
    return 0
  fi

  echo "Error: container cannot read the mounted workspace correctly: $ROOT" >&2
  echo >&2
  echo "Claude may report this as an EACCES parse error for $ROOT/.mcp.json even when that file does not exist." >&2
  echo >&2
  echo "Container preflight output:" >&2
  printf '%s\n' "$output" >&2
  echo >&2
  echo "Host-side path details:" >&2
  ls -ld "$ROOT" "$ROOT/.mcp.json" >&2 || true
  if command -v stat >/dev/null 2>&1; then
    stat -c '[aisb:claude] %n mode=%a owner=%U group=%G context=%C' "$ROOT" "$ROOT/.mcp.json" >&2 || true
  fi
  echo >&2
  echo "Most likely fix on SELinux hosts:" >&2
  echo "  AISB_RELABEL_WORKSPACE=1 claude doctor" >&2
  exit 1
}

# Older AISB versions mounted this directory as ~/.claude. Move that layout
# under a real persistent home so Claude's atomic writes to ~/.claude.json
# survive container removal.
if [[ ! -d "$CLAUDE_HOME_DIR/.claude" && ( -e "$CLAUDE_HOME_DIR/settings.json" || -e "$CLAUDE_HOME_DIR/.credentials.json" || -d "$CLAUDE_HOME_DIR/backups" ) ]]; then
  mkdir -p "$CLAUDE_HOME_DIR/.claude"
  shopt -s dotglob nullglob
  for path in "$CLAUDE_HOME_DIR"/*; do
    name="$(basename "$path")"
    [[ "$name" == ".claude" ]] && continue
    if [[ ! -e "$CLAUDE_HOME_DIR/.claude/$name" ]]; then
      mv "$path" "$CLAUDE_HOME_DIR/.claude/$name"
    fi
  done
  shopt -u dotglob nullglob
fi
mkdir -p "$CLAUDE_HOME_DIR/.claude"

# Seed shared Claude state from host on first run, else create empty
# placeholders so directory-level mounts preserve Claude's atomic rewrites.
if [[ ! -e "$CLAUDE_HOME_DIR/.claude.json" ]]; then
  if [[ -s "$HOME/.claude.json" ]]; then
    cp -p "$HOME/.claude.json" "$CLAUDE_HOME_DIR/.claude.json"
  else
    common_ensure_json_object_file "$CLAUDE_HOME_DIR/.claude.json" "Claude shared config"
  fi
fi
common_ensure_json_object_file "$CLAUDE_HOME_DIR/.claude.json" "Claude shared config"
if [[ ! -e "$CLAUDE_HOME_DIR/.claude/settings.json" ]]; then
  cp -p "$HOME/.claude/settings.json" "$CLAUDE_HOME_DIR/.claude/settings.json"
fi
common_ensure_json_object_file "$CLAUDE_HOME_DIR/.claude/settings.json" "Claude shared settings"
if [[ ! -e "$CLAUDE_HOME_DIR/.claude/.credentials.json" ]]; then
  cp -p "$HOME/.claude/.credentials.json" "$CLAUDE_HOME_DIR/.claude/.credentials.json"
fi
common_ensure_json_object_file "$CLAUDE_HOME_DIR/.claude/.credentials.json" "Claude shared credentials"
claude_check_project_mcp_json
claude_preflight_workspace_mount

TOOL_MOUNTS=(
  -v "${CLAUDE_HOME_DIR}:${USER_HOME}:rw,nosuid,nodev,noexec,z"
)

CLAUDE_SKILLS_HOST="$HOME/.claude/skills"
if [[ -d "$CLAUDE_SKILLS_HOST" ]]; then
  common_require_mount_path "$CLAUDE_SKILLS_HOST" "Claude skills source path"
  common_require_mount_path "${USER_HOME}/.claude/skills" "Claude skills destination path"
  TOOL_MOUNTS+=(-v "${CLAUDE_SKILLS_HOST}:${USER_HOME}/.claude/skills:ro,nosuid,nodev,noexec,z")
fi

CLAUDE_FLAGS=()
if [[ "${CLAUDE_SAFE_MODE:-0}" != "1" ]]; then
  CLAUDE_FLAGS+=(--dangerously-skip-permissions)
fi

CLAUDE_OPTS=()
CLAUDE_FORWARDED_VARS=()
for var in ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN; do
  if [[ -n "${!var:-}" ]]; then
    CLAUDE_OPTS+=(-e "${var}=${!var}")
    CLAUDE_FORWARDED_VARS+=("$var")
  fi
done
CLAUDE_OPTS+=(
  -e "DISABLE_AUTOUPDATER=1"
  -e "DISABLE_UPDATES=1"
  -e "XDG_CONFIG_HOME=${USER_HOME}/.config"
  -e "XDG_DATA_HOME=${USER_HOME}/.local/share"
)

if [[ "${AISB_QUIET:-0}" != "1" ]]; then
  if [[ "${AISB_DEBUG:-0}" == "1" ]]; then
    echo "[aisb:claude:debug] claude home: $CLAUDE_HOME_DIR -> ${USER_HOME} (rw, shared across repos)" >&2
    echo "[aisb:claude:debug] claude shared config: $CLAUDE_HOME_DIR/.claude.json -> ${USER_HOME}/.claude.json (rw)" >&2
  fi
  if ((${#CLAUDE_FORWARDED_VARS[@]})); then
    echo "[aisb:claude] claude env: forwarding ${CLAUDE_FORWARDED_VARS[*]}" >&2
  elif [[ "${AISB_DEBUG:-0}" == "1" ]]; then
    echo "[aisb:claude:debug] claude env: ANTHROPIC_API_KEY not set" >&2
  fi
  if [[ "${CLAUDE_SAFE_MODE:-0}" == "1" ]]; then
    echo "[aisb:claude] claude permissions: native prompts enabled" >&2
  else
    echo "[aisb:claude] claude permissions: bypassed with --dangerously-skip-permissions" >&2
  fi
  if [[ "${AISB_DEBUG:-0}" == "1" ]]; then
    echo "[aisb:claude:debug] updates: Claude self-updates disabled; use $SCRIPT_DIR/build-containers claude" >&2
  fi
fi

exec podman run "${COMMON_PODMAN_ARGS[@]}" "${CLAUDE_OPTS[@]}" "${TOOL_MOUNTS[@]}" \
  "$IMAGE" "${CLAUDE_FLAGS[@]}" "$@"
