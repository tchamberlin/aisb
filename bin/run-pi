#!/usr/bin/env bash
set -euo pipefail
SCRIPT_SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SCRIPT_SOURCE" ]]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"
  SCRIPT_SOURCE="$(readlink "$SCRIPT_SOURCE")"
  [[ "$SCRIPT_SOURCE" == /* ]] || SCRIPT_SOURCE="$SCRIPT_DIR/$SCRIPT_SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname "$SCRIPT_SOURCE")" && pwd)"

TOOL="pi"
USER_NAME="aisb-$TOOL"
USER_HOME="/home/$USER_NAME"
AISB_MOUNT_USER_HOME_TMPFS=0

# shellcheck source=bin/_run-common.sh
source "$SCRIPT_DIR/_run-common.sh"
common_init

# Repo-local models.json override — lets a repo pin custom model definitions
# without mutating shared pi state.
PROJECT_MODELS="$ROOT/.pi/agent/models.json"
PROJECT_MODELS_ENABLED=0
PROJECT_MODELS_OPTS=""
if [[ -L "$PROJECT_MODELS" ]]; then
  echo "Error: refusing symlinked repo pi models file: $PROJECT_MODELS" >&2
  exit 1
fi
if [[ -f "$PROJECT_MODELS" ]]; then
  PROJECT_MODELS_REAL="$(realpath "$PROJECT_MODELS")"
  if [[ "$PROJECT_MODELS_REAL" != "$ROOT" && "$PROJECT_MODELS_REAL" != "$ROOT"/* ]]; then
    echo "Error: refusing repo pi models file outside workspace: $PROJECT_MODELS -> $PROJECT_MODELS_REAL" >&2
    exit 1
  fi
  common_require_mount_path "$PROJECT_MODELS" "pi models source path"
  common_require_mount_path "${USER_HOME}/.pi/agent/models.json" "pi models destination path"
  PROJECT_MODELS_ENABLED=1
  PROJECT_MODELS_OPTS="ro,nosuid,nodev,noexec"
  if [[ "${AISB_RELABEL_WORKSPACE:-0}" == "1" ]]; then
    PROJECT_MODELS_OPTS+=",z"
  fi
fi

common_check_image

# Pi state lives in a shared durable home. Seed any host-side state on
# first use, then let the container own that shared copy across all repos.
mkdir -p "$HOME/.pi/agent"

PI_HOME_DIR="${STATE_BASE}/pi/home-pi"
mkdir -p "$PI_HOME_DIR"
if [[ ! -e "$PI_HOME_DIR/.pi" ]]; then
  cp -a "$HOME/.pi" "$PI_HOME_DIR/.pi"
fi
mkdir -p "$PI_HOME_DIR/.pi/agent"

common_require_mount_path "$PI_HOME_DIR" "pi home source path"
common_require_mount_path "${USER_HOME}/.pi/agent" "pi state destination path"

TOOL_MOUNTS=(
  -v "${PI_HOME_DIR}:${USER_HOME}:rw,nosuid,nodev,noexec,z"
)

if [[ "$PROJECT_MODELS_ENABLED" == "1" ]]; then
  TOOL_MOUNTS+=(-v "${PROJECT_MODELS}:${USER_HOME}/.pi/agent/models.json:${PROJECT_MODELS_OPTS}")
fi

PI_SKILLS_HOST="$HOME/.pi/skills"
if [[ -d "$PI_SKILLS_HOST" ]]; then
  common_require_mount_path "$PI_SKILLS_HOST" "pi skills source path"
  common_require_mount_path "${USER_HOME}/.pi/skills" "pi skills destination path"
  TOOL_MOUNTS+=(-v "${PI_SKILLS_HOST}:${USER_HOME}/.pi/skills:ro,nosuid,nodev,noexec,z")
fi

# Optional central env file: pi has no login flow, so API keys for its five
# supported providers are the only auth path. Source a user-owned file so the
# keys are available regardless of the calling shell.
PI_ENV_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/aisb/pi.env"
PI_ENV_FILE_LOADED=0
PI_ENV_FILE_VARS=()
if [[ -L "$PI_ENV_FILE" ]]; then
  echo "Error: refusing symlinked pi env file: $PI_ENV_FILE" >&2
  exit 1
fi
if [[ -e "$PI_ENV_FILE" ]]; then
  if [[ ! -f "$PI_ENV_FILE" ]]; then
    echo "Error: pi env file is not a regular file: $PI_ENV_FILE" >&2
    exit 1
  fi
  pi_env_mode="$(stat -c '%a' "$PI_ENV_FILE" 2>/dev/null || echo "")"
  if [[ ! "$pi_env_mode" =~ ^[0-9]*00$ ]]; then
    echo "Error: pi env file is group/other accessible: $PI_ENV_FILE (mode $pi_env_mode)" >&2
    echo "Run: chmod 600 '$PI_ENV_FILE'" >&2
    exit 1
  fi
  set -a
  # shellcheck disable=SC1090
  source "$PI_ENV_FILE"
  set +a
  # Collect names assigned at the start of a line (KEY=... or export KEY=...).
  # This is what gets forwarded — predictable from reading the file.
  mapfile -t PI_ENV_FILE_VARS < <(
    awk '
      /^[[:space:]]*#/ { next }
      match($0, /^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=/, m) { print m[2] }
    ' "$PI_ENV_FILE" | awk '!seen[$0]++'
  )
  PI_ENV_FILE_LOADED=1
fi

# Forward API keys and editor preferences that pi reads
PI_OPTS=()
PI_FORWARDED_VARS=()
for var in ANTHROPIC_API_KEY OPENAI_API_KEY GOOGLE_API_KEY OPENROUTER_API_KEY TOGETHER_API_KEY PI_CODING_AGENT_DIR PI_TELEMETRY PI_CACHE_RETENTION PI_SKIP_VERSION_CHECK VISUAL EDITOR; do
  if [[ -n "${!var:-}" ]]; then
    PI_OPTS+=(-e "${var}=${!var}")
    PI_FORWARDED_VARS+=("$var")
  fi
done

# Also forward anything new that the env file introduced (e.g. provider keys
# we don't know about yet, or per-provider base-url/model overrides).
for var in "${PI_ENV_FILE_VARS[@]}"; do
  case " ${PI_FORWARDED_VARS[*]} " in *" $var "*) continue ;; esac
  if [[ -n "${!var:-}" ]]; then
    PI_OPTS+=(-e "${var}=${!var}")
    PI_FORWARDED_VARS+=("$var")
  fi
done

if [[ "${AISB_QUIET:-0}" != "1" ]]; then
  echo "[aisb:pi] pi home: $PI_HOME_DIR" >&2
  if [[ "$PROJECT_MODELS_ENABLED" == "1" ]]; then
    echo "[aisb:pi] pi models: $PROJECT_MODELS (repo override)" >&2
  else
    echo "[aisb:pi] pi models: default" >&2
  fi
  if [[ "$PI_ENV_FILE_LOADED" == "1" ]]; then
    echo "[aisb:pi] pi env file: $PI_ENV_FILE" >&2
  fi
  if ((${#PI_FORWARDED_VARS[@]})); then
    echo "[aisb:pi] pi env: forwarding ${PI_FORWARDED_VARS[*]}" >&2
  else
    echo "[aisb:pi] pi env: no optional vars forwarded" >&2
  fi
fi

exec podman run "${COMMON_PODMAN_ARGS[@]}" \
  "${PI_OPTS[@]}" "${TOOL_MOUNTS[@]}" \
  "$IMAGE" "$@"
